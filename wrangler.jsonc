{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concost-claim-center-preview",
  "main": "apps/cloudflare/src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concost-claim-center-preview-db",
      "database_id": "78094a1c-abe0-451d-bc12-68d0d37166d8",
      "migrations_dir": "apps/cloudflare/migrations"
    }
  ],
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/health", "/readiness"]
  },
  "observability": {
    "enabled": true
  }
}
