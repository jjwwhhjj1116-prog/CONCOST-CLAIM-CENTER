generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../.data/dev.db"
}

model Organization {
  id        String     @id
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  cases     CaseItem[]
  auditLogs AuditLog[]
}

model User {
  id               String              @id
  email            String              @unique
  passwordHash     String
  name             String
  organizationId   String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles            UserRole[]
  sessions         Session[]
  assignments      CaseAssignment[]
  assignedCases    CaseItem[]          @relation("AssignedCases")
  statusHistories  StatusHistory[]
  auditLogs        AuditLog[]
  uploadedVersions DocumentVersion[]
  createdMeetings  Meeting[]
  actionItems      MeetingActionItem[]
}

model Role {
  id    String     @id
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseItem {
  id             String           @id
  organizationId String
  caseNumber     String           @unique
  title          String
  description    String?
  claimType      String
  status         String           @default("INQUIRY")
  assignedUserId String?
  version        Int              @default(1)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedUser   User?            @relation("AssignedCases", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignments    CaseAssignment[]
  category       CaseCategory?
  parties        Party[]
  schedules      Schedule[]
  statusHistories StatusHistory[]
  reports        Report[]
  documents      Document[]
  meetings       Meeting[]

  @@index([organizationId, deletedAt])
  @@index([caseNumber])
  @@index([status])
}

model CaseCategory {
  id        String   @id
  caseId    String   @unique
  major     String
  middle    String
  minor     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([major, middle, minor])
}

model CaseAssignment {
  caseId String
  userId String
  case   CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
}

model Party {
  id        String   @id
  caseId    String
  name      String
  role      String
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([name])
}

model Schedule {
  id          String              @id
  caseId      String
  title       String
  type        String
  date        DateTime
  location    String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        CaseItem            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]

  @@index([caseId])
  @@index([date])
  @@index([type])
}

model StatusHistory {
  id          String   @id
  caseId      String
  fromStatus  String?
  toStatus    String
  changedById String
  reason      String?
  createdAt   DateTime @default(now())
  case        CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model Document {
  id               String            @id
  caseId           String
  title            String
  category         String?
  source           String            // RECEIVED, AUTHORED, SUBMITTED
  currentVersionId String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  case             CaseItem          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]

  @@index([caseId, deletedAt])
  @@index([source])
}

model DocumentVersion {
  id            String   @id
  documentId    String
  versionNumber Int
  displayName   String
  storageKey    String   @unique
  fileSize      Int
  mimeType      String
  sha256        String
  isFinal       Boolean  @default(false)
  uploadedById  String
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([storageKey])
}

model Meeting {
  id          String              @id
  caseId      String
  title       String
  meetingDate DateTime
  location    String?
  attendees   String?
  rawText     String?
  summary     String?
  decisions   String?
  status      String              @default("DRAFT") // DRAFT, FINAL
  version     Int                 @default(1)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        CaseItem            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  actionItems MeetingActionItem[]

  @@index([caseId])
  @@index([meetingDate])
  @@index([status])
}

model MeetingActionItem {
  id          String    @id
  meetingId   String
  title       String
  assigneeId  String?
  scheduleId  String?
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  schedule    Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([assigneeId])
  @@index([scheduleId])
}

model Report {
  id        String          @id
  caseId    String
  title     String
  version   Int             @default(1)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  case      CaseItem        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sections  ReportSection[]

  @@index([caseId, deletedAt])
}

model ReportSection {
  id        String    @id
  reportId  String
  title     String
  content   String
  status    String
  version   Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, deletedAt])
}

model AuditLog {
  id             String        @id
  organizationId String?
  userId         String?
  action         String
  targetEntity   String
  targetId       String
  metadataJson   String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}
