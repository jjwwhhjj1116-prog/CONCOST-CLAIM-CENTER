generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../.data/dev.db"
}

model Organization {
  id        String     @id
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  cases     CaseItem[]
  auditLogs AuditLog[]
  reportTemplates ReportTemplate[]
  reportInstances ReportInstance[]
  aiProviderConfigs AiProviderConfig[]
  aiUsageLedgers AiUsageLedger[]
  aiGenerationRequests AiGenerationRequest[]
}

model User {
  id                      String            @id
  email                   String            @unique
  passwordHash            String
  name                    String
  organizationId          String
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  organization            Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                   UserRole[]
  sessions                Session[]
  assignments             CaseAssignment[]
  assignedCases           CaseItem[]        @relation("AssignedCases")
  statusHistories         StatusHistory[]
  auditLogs               AuditLog[]
  uploadedVersions        DocumentVersion[]
  createdMeetings         Meeting[]
  actionItems             MeetingActionItem[]
  createdProposals        Proposal[]        @relation("ProposalCreator")
  updatedProposals        Proposal[]        @relation("ProposalUpdater")
  createdProposalVersions ProposalVersion[] @relation("ProposalVersionCreator")
  proposalReviews         ProposalReview[]
  createdReportTemplates  ReportTemplate[]        @relation("ReportTemplateCreator")
  createdReportTemplateVersions ReportTemplateVersion[] @relation("ReportTemplateVersionCreator")
  approvedReportTemplateVersions ReportTemplateVersion[] @relation("ReportTemplateVersionApprover")
  createdReportInstances  ReportInstance[]         @relation("ReportInstanceCreator")
  createdSectionRevisions ReportSectionRevision[] @relation("SectionRevisionAuthor")
  createdSectionComments ReportSectionComment[]  @relation("SectionCommentAuthor")
  resolvedSectionComments ReportSectionComment[] @relation("SectionCommentResolver")
  approvedReportSections ReportSectionApproval[] @relation("SectionApprovalApprover")
  createdReportMergeSnapshots ReportMergeSnapshot[] @relation("ReportMergeSnapshotCreator")
  aiUsageLedgers AiUsageLedger[]
  aiGenerationRequests AiGenerationRequest[]
}

model Role {
  id    String     @id
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseItem {
  id             String           @id
  organizationId String
  caseNumber     String           @unique
  title          String
  description    String?
  claimType      String
  status         String           @default("INQUIRY")
  assignedUserId String?
  version        Int              @default(1)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedUser   User?            @relation("AssignedCases", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignments    CaseAssignment[]
  category       CaseCategory?
  parties        Party[]
  schedules      Schedule[]
  statusHistories StatusHistory[]
  reports        Report[]
  documents      Document[]
  meetings       Meeting[]
  proposals      Proposal[]
  reportInstances ReportInstance[]
  aiPolicy       AiCasePolicy?
  aiUsageLedgers AiUsageLedger[]
  aiGenerationRequests AiGenerationRequest[]

  @@index([organizationId, deletedAt])
  @@index([caseNumber])
  @@index([status])
}

model CaseCategory {
  id        String   @id
  caseId    String   @unique
  major     String
  middle    String
  minor     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([major, middle, minor])
}

model CaseAssignment {
  caseId String
  userId String
  case   CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
}

model Party {
  id        String   @id
  caseId    String
  name      String
  role      String
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([name])
}

model Schedule {
  id          String              @id
  caseId      String
  title       String
  type        String
  date        DateTime
  location    String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        CaseItem            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]
  documents   Document[]

  @@index([caseId])
  @@index([date])
  @@index([type])
}

model StatusHistory {
  id          String   @id
  caseId      String
  fromStatus  String?
  toStatus    String
  changedById String
  reason      String?
  createdAt   DateTime @default(now())
  case        CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model Document {
  id               String            @id
  caseId           String
  scheduleId       String?
  reportSectionId  String?
  proposalVersionId String?
  title            String
  category         String?
  source           String            // RECEIVED, AUTHORED, SUBMITTED
  currentVersionId String?
  finalVersionId   String?
  version          Int               @default(1)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  case             CaseItem          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  schedule         Schedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  reportSection    ReportSection?    @relation(fields: [reportSectionId], references: [id], onDelete: SetNull)
  proposalVersion  ProposalVersion?  @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[]

  @@index([caseId, deletedAt])
  @@index([scheduleId])
  @@index([reportSectionId])
  @@index([proposalVersionId])
  @@index([source])
}

model DocumentVersion {
  id            String   @id
  documentId    String
  versionNumber Int
  originalName  String
  displayName   String
  storageKey    String   @unique
  fileSize      Int
  mimeType      String
  sha256        String
  isFinal       Boolean  @default(false)
  uploadedById  String
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  evidenceLinks ReportEvidenceLink[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([storageKey])
}

model Meeting {
  id            String              @id
  caseId        String
  title         String
  meetingDate   DateTime
  location      String?
  attendees     String?
  rawText       String?
  rawTextSha256 String?
  summary       String?
  decisions     String?
  status        String              @default("DRAFT") // DRAFT, FINAL
  version       Int                 @default(1)
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  case          CaseItem            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  actionItems   MeetingActionItem[]
  evidenceLinks ReportEvidenceLink[]

  @@index([caseId])
  @@index([meetingDate])
  @@index([status])
}

model MeetingActionItem {
  id         String    @id
  meetingId  String
  title      String
  assigneeId String?
  scheduleId String?
  dueDate    DateTime?
  status     String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([assigneeId])
  @@index([scheduleId])
}

model Report {
  id        String          @id
  caseId    String
  reportInstanceId String?  @unique
  title     String
  version   Int             @default(1)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  case      CaseItem        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reportInstance ReportInstance? @relation(fields: [reportInstanceId], references: [id], onDelete: Restrict)
  sections  ReportSection[]
  mergeSnapshots ReportMergeSnapshot[]

  @@index([caseId, deletedAt])
}

model ReportSection {
  id        String     @id
  reportId  String
  templateSectionIdSnapshot String?
  sectionNumber Int      @default(1)
  title     String
  content   String
  status    String
  isRequired Boolean     @default(false)
  blockSchemaSnapshotJson String @default("{}")
  version   Int        @default(1)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  report    Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  documents Document[]
  revisions ReportSectionRevision[]
  comments  ReportSectionComment[]
  approvals ReportSectionApproval[]

  @@index([reportId, deletedAt])
}

model ProposalTemplate {
  id               String     @id
  name             String
  claimType        String     // TYPE-01 to TYPE-06
  description      String?
  bodyTemplate     String
  placeholdersJson String
  version          Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  proposals        Proposal[]

  @@index([claimType])
}

model Proposal {
  id               String            @id
  caseId           String
  templateId       String
  templateVersionSnapshot Int
  templateBodySnapshot String
  templatePlaceholdersSnapshotJson String
  title            String
  status           String            @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, REJECTED
  currentVersionId String?
  approvedVersionId String?
  outputDocumentId String?
  version          Int               @default(1)
  createdById      String
  updatedById      String
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  case             CaseItem          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template         ProposalTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User              @relation("ProposalUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  versions         ProposalVersion[]
  reviews          ProposalReview[]

  @@index([caseId, deletedAt])
  @@index([templateId])
  @@index([updatedById])
  @@index([status])
}

model ProposalVersion {
  id                           String           @id
  proposalId                   String
  versionNumber                Int
  bodyText                     String
  structuredInputsJson         String
  renderedValuesJson           String
  missingFieldsJson            String
  generationMode               String           // MANUAL, AI
  providerId                   String?
  modelId                      String?
  promptConfigVersion          String?
  inputSha256                   String
  generatedAt                  DateTime?
  sourceDocumentVersionIdsJson String?
  sha256                       String
  isApproved                   Boolean          @default(false)
  createdById                  String
  createdAt                    DateTime         @default(now())
  proposal                     Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdBy                    User             @relation("ProposalVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviews                      ProposalReview[]
  outputDocuments              Document[]

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
}

model ProposalReview {
  id         String          @id
  proposalId String
  versionId  String
  reviewerId String
  action     String          // REQUEST_REVIEW, APPROVE, REJECT
  comment    String?
  createdAt  DateTime        @default(now())
  proposal   Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer   User            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([versionId])
  @@index([reviewerId])
}

model ReferenceInventory {
  id             String   @id
  fileId         String   @unique
  sha256         String
  fileSize       Int
  scanStatus     String   @default("UNSCANNED")
  approvalStatus String   @default("REVIEW_REQUIRED")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  templateReferences TemplateReference[]

  @@index([approvalStatus])
}

model ReportTemplate {
  id             String   @id
  organizationId String
  code           String
  name           String
  description    String?
  status         String   @default("ACTIVE")
  version        Int      @default(1)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User     @relation("ReportTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions       ReportTemplateVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model ReportTemplateVersion {
  id                         String   @id
  templateId                 String
  versionNumber              Int
  rowVersion                 Int      @default(1)
  name                       String
  companyForm                String
  tocStructureJson           String
  requiredSectionsJson       String
  requiredEvidenceRulesJson  String
  blockSchemasJson           String
  contentSha256              String
  status                     String   @default("DRAFT")
  createdById                String
  approvedById               String?
  approvedAt                 DateTime?
  activatedAt                DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  template                   ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy                  User     @relation("ReportTemplateVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy                 User?    @relation("ReportTemplateVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  typeMappings               TemplateTypeMapping[]
  sections                   TemplateSection[]
  references                 TemplateReference[]
  reportInstances            ReportInstance[]

  @@unique([templateId, versionNumber])
  @@index([templateId, status])
}

model TemplateTypeMapping {
  id                String   @id
  templateVersionId String
  typeId            String
  kind              String
  createdAt         DateTime @default(now())
  templateVersion   ReportTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@unique([templateVersionId, typeId])
  @@index([typeId, kind])
}

model TemplateSection {
  id                String   @id
  templateVersionId String
  sectionNumber     Int
  title             String
  isRequired        Boolean  @default(false)
  description       String?
  blockSchemaSnapshotJson String
  createdAt         DateTime @default(now())
  templateVersion   ReportTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  blocks            TemplateSectionBlock[]

  @@unique([templateVersionId, sectionNumber])
  @@index([templateVersionId])
}

model TemplateSectionBlock {
  id                     String   @id
  templateSectionId      String
  blockDefinitionId      String
  position               Int
  blockCodeSnapshot      String
  blockVersionSnapshot   Int
  blockSchemaSnapshotJson String
  createdAt              DateTime @default(now())
  templateSection        TemplateSection @relation(fields: [templateSectionId], references: [id], onDelete: Restrict)
  blockDefinition        BlockDefinition @relation(fields: [blockDefinitionId], references: [id], onDelete: Restrict)

  @@unique([templateSectionId, position])
  @@index([blockDefinitionId])
}

model TemplateReference {
  id                String   @id
  templateVersionId String
  referenceId       String
  fileIdSnapshot    String
  sha256Snapshot    String
  fileSizeSnapshot  Int
  createdAt         DateTime @default(now())
  templateVersion   ReportTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  reference         ReferenceInventory @relation(fields: [referenceId], references: [id], onDelete: Restrict)

  @@unique([templateVersionId, referenceId])
  @@index([templateVersionId])
}

model BlockDefinition {
  id          String   @id
  code        String
  name        String
  description String?
  schemaJson  String
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sectionMappings TemplateSectionBlock[]

  @@unique([code, version])
  @@index([code, status])
}

model ReportInstance {
  id                                  String   @id
  organizationId                      String
  caseId                              String
  templateVersionId                   String
  createdById                         String
  version                             Int      @default(1)
  templateCodeSnapshot                String
  templateNameSnapshot                String
  templateVersionNumberSnapshot       Int
  companyFormSnapshot                 String
  tocStructureSnapshotJson            String
  requiredSectionsSnapshotJson        String
  requiredEvidenceRulesSnapshotJson   String
  blockSchemasSnapshotJson            String
  referenceProvenanceSnapshotJson      String
  snapshotSha256                      String
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt
  organization                        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case                                CaseItem @relation(fields: [caseId], references: [id], onDelete: Restrict)
  templateVersion                     ReportTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  createdBy                           User @relation("ReportInstanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  report                              Report?

  @@index([organizationId, caseId])
  @@index([templateVersionId])
}

model AuditLog {
  id             String        @id
  organizationId String?
  userId         String?
  action         String
  targetEntity   String
  targetId       String
  metadataJson   String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model ReportSectionRevision {
  id                    String                @id
  sectionId             String
  revisionNumber        Int
  title                 String
  content               String
  structuredDataJson    String                @default("{}")
  validationStatus      String                @default("VALID") // VALID, INVALID, WARNING
  validationErrorsJson  String                @default("[]")
  inputSha256           String
  sha256                String
  authorId              String
  createdAt             DateTime              @default(now())
  section               ReportSection         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  author                User                  @relation("SectionRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  evidenceLinks         ReportEvidenceLink[]
  comments              ReportSectionComment[]
  approvals             ReportSectionApproval[]

  @@unique([sectionId, revisionNumber])
  @@index([sectionId])
  @@index([authorId])
}

model ReportEvidenceLink {
  id                      String                @id
  revisionId              String
  sourceType              String                // DOCUMENT, MEETING
  sourceId                String
  sourceDocumentVersionId String?
  sourceMeetingId         String?
  sourceSha256            String
  sourceVersion           Int                   @default(1)
  targetParagraphIndex    Int
  quoteText               String?
  anchorPosition          String?
  createdAt               DateTime              @default(now())
  revision                ReportSectionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  documentVersion         DocumentVersion?      @relation(fields: [sourceDocumentVersionId], references: [id], onDelete: Restrict)
  meeting                 Meeting?              @relation(fields: [sourceMeetingId], references: [id], onDelete: Restrict)

  @@unique([revisionId, sourceType, sourceId, targetParagraphIndex])
  @@index([revisionId])
  @@index([sourceDocumentVersionId])
  @@index([sourceMeetingId])
}

model ReportSectionComment {
  id            String                 @id
  sectionId     String
  revisionId    String?
  authorId      String
  commentType   String                 @default("COMMENT") // COMMENT, REVISION_REQUEST
  content       String
  isResolved    Boolean                @default(false)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime               @default(now())
  section       ReportSection          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  revision      ReportSectionRevision? @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  author        User                   @relation("SectionCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  resolvedBy    User?                  @relation("SectionCommentResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([sectionId])
  @@index([revisionId])
  @@index([authorId])
}

model ReportSectionApproval {
  id                 String                @id
  sectionId          String
  approvedRevisionId String
  approverId         String
  eventNumber        Int
  status             String                @default("APPROVED") // APPROVED, UNLOCKED
  comment            String?
  createdAt          DateTime              @default(now())
  section            ReportSection         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  approvedRevision   ReportSectionRevision @relation(fields: [approvedRevisionId], references: [id], onDelete: Restrict)
  approver           User                  @relation("SectionApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([sectionId, eventNumber])
  @@index([sectionId])
  @@index([approvedRevisionId])
  @@index([approverId])
}

model ReportMergeSnapshot {
  id                    String   @id
  reportId              String
  snapshotVersion       Int
  mergedBodyText        String
  sectionsSnapshotJson  String
  evidenceSnapshotJson  String
  snapshotSha256        String
  createdById           String
  createdAt             DateTime @default(now())
  report                Report   @relation(fields: [reportId], references: [id], onDelete: Restrict)
  createdBy             User     @relation("ReportMergeSnapshotCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([reportId, snapshotVersion])
  @@index([reportId])
  @@index([createdById])
}

model AiProviderConfig {
  id                 String                @id
  organizationId     String
  providerKind       String                // LOCAL_FAKE, OPENAI, ANTHROPIC, GEMINI
  name               String
  baseUrl            String
  secretRef          String                // API 키 환경변수/Secret Manager 참해보 레퍼런스 (원문 키 아님)
  status             String                @default("ACTIVE") // ACTIVE, DISABLED
  allowedModelsJson  String                @default("[]")
  timeoutMs          Int                   @default(30000)
  maxRetries         Int                   @default(3)
  dailyBudgetMicros  Int                   @default(100000000) // Micro-USD (e.g. 100 USD = 100,000,000 micros)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requests           AiGenerationRequest[]
  ledgers            AiUsageLedger[]

  @@index([organizationId, status])
}

model AiCasePolicy {
  id                      String   @id
  caseId                  String   @unique
  externalAiAllowed       Boolean  @default(false)
  maxTokensPerRequest     Int      @default(4096)
  maxCostMicrosPerRequest Int      @default(1000000) // 1 USD
  allowedProviderIdsJson  String   @default("[]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  case                    CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model AiUsageLedger {
  id                String               @id
  organizationId    String
  caseId            String
  userId            String
  providerConfigId  String
  modelCode         String
  requestId         String?
  transactionType   String               // RESERVATION, RECONCILIATION, ADJUSTMENT
  promptTokens      Int                  @default(0)
  completionTokens  Int                  @default(0)
  totalTokens       Int                  @default(0)
  costMicros        Int                  @default(0) // Micro-USD 정수
  createdAt         DateTime             @default(now())
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case              CaseItem             @relation(fields: [caseId], references: [id], onDelete: Restrict)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  providerConfig    AiProviderConfig     @relation(fields: [providerConfigId], references: [id], onDelete: Restrict)
  request           AiGenerationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([caseId])
  @@index([userId])
  @@index([requestId])
  @@unique([requestId, transactionType])
}

model AiGenerationRequest {
  id                   String                @id
  organizationId       String
  caseId               String
  userId               String
  providerConfigId     String
  modelCode            String
  status               String                @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELED
  promptSha256         String
  requestFingerprintSha256 String
  idempotencyKey       String
  reservedCostMicros   Int                   @default(0)
  actualCostMicros     Int                   @default(0)
  totalTokens          Int                   @default(0)
  responseMetadataJson String                @default("{}")
  redactedErrorMessage String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  case                 CaseItem              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  providerConfig       AiProviderConfig      @relation(fields: [providerConfigId], references: [id], onDelete: Restrict)
  attempts             AiGenerationAttempt[]
  ledgers              AiUsageLedger[]

  @@unique([organizationId, caseId, userId, idempotencyKey])
  @@index([organizationId, status])
  @@index([caseId])
  @@index([userId])
}

model AiGenerationAttempt {
  id                   String              @id
  requestId            String
  attemptNumber        Int
  status               String              // PROCESSING, SUCCESS, TRANSIENT_FAILURE, HARD_FAILURE, CANCELED, TIMEOUT
  statusCode           Int?
  redactedErrorMessage String?
  durationMs           Int                 @default(0)
  createdAt            DateTime            @default(now())
  request              AiGenerationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, attemptNumber])
}
