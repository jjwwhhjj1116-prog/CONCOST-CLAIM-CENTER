generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../.data/dev.db"
}

model Organization {
  id        String     @id
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  cases     CaseItem[]
  auditLogs AuditLog[]
}

model User {
  id                               String                  @id
  email                            String                  @unique
  passwordHash                     String
  name                             String
  organizationId                   String
  isActive                         Boolean                 @default(true)
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  organization                     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                            UserRole[]
  sessions                         Session[]
  assignments                      CaseAssignment[]
  assignedCases                    CaseItem[]              @relation("AssignedCases")
  statusHistories                  StatusHistory[]
  auditLogs                        AuditLog[]
  uploadedVersions                 DocumentVersion[]
  createdMeetings                  Meeting[]
  actionItems                      MeetingActionItem[]
  createdProposals                 Proposal[]              @relation("ProposalCreator")
  updatedProposals                 Proposal[]              @relation("ProposalUpdater")
  createdProposalVersions          ProposalVersion[]       @relation("ProposalVersionCreator")
  proposalReviews                  ProposalReview[]
  createdReportTemplateVersions   ReportTemplateVersion[] @relation("TemplateVersionCreator")
  approvedReportTemplateVersions  ReportTemplateVersion[] @relation("TemplateVersionApprover")
  createdReportInstances          ReportInstance[]        @relation("ReportInstanceCreator")
}

model Role {
  id    String     @id
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CaseItem {
  id              String           @id
  organizationId  String
  caseNumber      String           @unique
  title           String
  description     String?
  claimType       String
  status          String           @default("INQUIRY")
  assignedUserId  String?
  version         Int              @default(1)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedUser    User?            @relation("AssignedCases", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignments     CaseAssignment[]
  category        CaseCategory?
  parties         Party[]
  schedules       Schedule[]
  statusHistories StatusHistory[]
  reports         Report[]
  documents       Document[]
  meetings        Meeting[]
  proposals       Proposal[]
  reportInstances ReportInstance[]

  @@index([organizationId, deletedAt])
  @@index([caseNumber])
  @@index([status])
}

model CaseCategory {
  id        String   @id
  caseId    String   @unique
  major     String
  middle    String
  minor     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([major, middle, minor])
}

model CaseAssignment {
  caseId String
  userId String
  case   CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
}

model Party {
  id        String   @id
  caseId    String
  name      String
  role      String
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([name])
}

model Schedule {
  id          String              @id
  caseId      String
  title       String
  type        String
  date        DateTime
  location    String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        CaseItem            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]
  documents   Document[]

  @@index([caseId])
  @@index([date])
  @@index([type])
}

model StatusHistory {
  id          String   @id
  caseId      String
  fromStatus  String?
  toStatus    String
  changedById String
  reason      String?
  createdAt   DateTime @default(now())
  case        CaseItem @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model Document {
  id                String           @id
  caseId            String
  scheduleId        String?
  reportSectionId   String?
  proposalVersionId String?
  title             String
  category          String?
  source            String // RECEIVED, AUTHORED, SUBMITTED
  currentVersionId  String?
  finalVersionId    String?
  version           Int              @default(1)
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  case              CaseItem         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  schedule          Schedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  reportSection     ReportSection?   @relation(fields: [reportSectionId], references: [id], onDelete: SetNull)
  proposalVersion   ProposalVersion? @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  versions          DocumentVersion[]

  @@index([caseId, deletedAt])
  @@index([scheduleId])
  @@index([reportSectionId])
  @@index([proposalVersionId])
  @@index([source])
}

model DocumentVersion {
  id            String   @id
  documentId    String
  versionNumber Int
  originalName  String
  displayName   String
  storageKey    String   @unique
  fileSize      Int
  mimeType      String
  sha256        String
  isFinal       Boolean  @default(false)
  uploadedById  String
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([storageKey])
}

model Meeting {
  id            String              @id
  caseId        String
  title         String
  meetingDate   DateTime
  location      String?
  attendees     String?
  rawText       String?
  rawTextSha256 String?
  summary       String?
  decisions     String?
  status        String              @default("DRAFT") // DRAFT, FINAL
  version       Int                 @default(1)
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  case          CaseItem            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  actionItems   MeetingActionItem[]

  @@index([caseId])
  @@index([meetingDate])
  @@index([status])
}

model MeetingActionItem {
  id         String    @id
  meetingId  String
  title      String
  assigneeId String?
  scheduleId String?
  dueDate    DateTime?
  status     String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([assigneeId])
  @@index([scheduleId])
}

model Report {
  id               String          @id
  caseId           String
  reportInstanceId String?
  title            String
  version          Int             @default(1)
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  case             CaseItem        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reportInstance   ReportInstance? @relation(fields: [reportInstanceId], references: [id], onDelete: SetNull)
  sections         ReportSection[]

  @@index([caseId, deletedAt])
  @@index([reportInstanceId])
}

model ReportSection {
  id             String     @id
  reportId       String
  sectionNumber  Int        @default(1)
  title          String
  content        String
  status         String
  isRequired     Boolean    @default(false)
  version        Int        @default(1)
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  report         Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  documents      Document[]

  @@index([reportId, deletedAt])
}

model ProposalTemplate {
  id               String     @id
  name             String
  claimType        String     // TYPE-01 to TYPE-06
  description      String?
  bodyTemplate     String
  placeholdersJson String
  version          Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  proposals        Proposal[]

  @@index([claimType])
}

model Proposal {
  id                               String            @id
  caseId                           String
  templateId                       String
  templateVersionSnapshot          Int
  templateBodySnapshot             String
  templatePlaceholdersSnapshotJson String
  title                            String
  status                           String            @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, REJECTED
  currentVersionId                 String?
  approvedVersionId                String?
  outputDocumentId                 String?
  version                          Int               @default(1)
  createdById                      String
  updatedById                      String
  deletedAt                        DateTime?
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt
  case                             CaseItem          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template                         ProposalTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy                        User              @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                        User              @relation("ProposalUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  versions                         ProposalVersion[]
  reviews                          ProposalReview[]

  @@index([caseId, deletedAt])
  @@index([templateId])
  @@index([updatedById])
  @@index([status])
}

model ProposalVersion {
  id                           String           @id
  proposalId                   String
  versionNumber                Int
  bodyText                     String
  structuredInputsJson         String
  renderedValuesJson           String
  missingFieldsJson            String
  generationMode               String           // MANUAL, AI
  providerId                   String?
  modelId                      String?
  promptConfigVersion          String?
  inputSha256                  String
  generatedAt                  DateTime?
  sourceDocumentVersionIdsJson String?
  sha256                       String
  isApproved                   Boolean          @default(false)
  createdById                  String
  createdAt                    DateTime         @default(now())
  proposal                     Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdBy                    User             @relation("ProposalVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviews                      ProposalReview[]
  outputDocuments              Document[]

  @@unique([proposalId, versionNumber])
  @@index([proposalId])
}

model ProposalReview {
  id         String          @id
  proposalId String
  versionId  String
  reviewerId String
  action     String          // REQUEST_REVIEW, APPROVE, REJECT
  comment    String?
  createdAt  DateTime        @default(now())
  proposal   Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer   User            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([versionId])
  @@index([reviewerId])
}

// --- P08 Report Template & Catalog Domain Models ---

model ReferenceInventory {
  id             String   @id // e.g. TPL-REF-001
  fileId         String   @unique // 익명 fileId (TPL-REF-001)
  sha256         String
  fileSize       Int
  scanStatus     String   @default("UNSCANNED") // UNSCANNED, SCANNED
  approvalStatus String   @default("REVIEW_REQUIRED") // UNCLASSIFIED, REVIEW_REQUIRED, HUMAN_APPROVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fileId])
  @@index([approvalStatus])
}

model ReportTemplate {
  id          String                  @id // e.g. RPT-TPL-001
  code        String                  @unique
  name        String
  description String?
  status      String                  @default("ACTIVE")
  version     Int                     @default(1)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    ReportTemplateVersion[]

  @@index([code])
}

model ReportTemplateVersion {
  id                         String               @id // e.g. RPT-TPL-VER-001
  templateId                 String
  versionNumber              Int
  name                       String
  companyForm                String               // 회사 표준 양식 설명/이름
  tocStructureJson           String               // 목차 구조 JSON
  requiredSectionsJson       String               // 필수 장 목록 JSON
  requiredEvidenceRulesJson String               // 필수 증빙 자료 규칙 JSON
  blockSchemasJson           String               // 블록 스키마 JSON
  referenceFileIdsJson       String               // 익명 fileId 배열 JSON
  status                     String               @default("DRAFT") // DRAFT, HUMAN_APPROVED, ACTIVE, ARCHIVED
  createdById                String
  approvedById               String?
  approvedAt                 DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  template                   ReportTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy                  User                 @relation("TemplateVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy                 User?                @relation("TemplateVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  typeMappings               TemplateTypeMapping[]
  sections                   TemplateSection[]
  reportInstances            ReportInstance[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@index([status])
}

model TemplateTypeMapping {
  id                String                @id
  templateVersionId String
  typeId            String                // TYPE-01 to TYPE-06
  kind              String                // PRIMARY, SECONDARY
  createdAt         DateTime              @default(now())
  templateVersion   ReportTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, typeId])
  @@index([templateVersionId])
  @@index([typeId, kind])
}

model TemplateSection {
  id                String                @id
  templateVersionId String
  sectionNumber     Int
  title             String
  isRequired        Boolean               @default(false)
  description       String?
  defaultBlocksJson String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  templateVersion   ReportTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, sectionNumber])
  @@index([templateVersionId])
}

model BlockDefinition {
  id          String   @id
  code        String   @unique // OVERVIEW, CONTRACT, FACTS, PHOTO_ANALYSIS, COST_CALC, LEGAL_REVIEW, OPINION, CONCLUSION
  name        String
  description String?
  schemaJson  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReportInstance {
  id                              String                @id
  caseId                          String
  templateVersionId               String
  templateVersionNumberSnapshot   Int
  companyFormSnapshot             String
  tocStructureSnapshotJson        String
  requiredSectionsSnapshotJson    String
  requiredEvidenceRulesSnapshotJson String
  blockSchemasSnapshotJson        String
  title                           String
  status                          String                @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED
  version                         Int                   @default(1)
  createdById                     String
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  case                            CaseItem              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateVersion                 ReportTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  createdBy                       User                  @relation("ReportInstanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reports                         Report[]

  @@index([caseId])
  @@index([templateVersionId])
  @@index([createdById])
}

model AuditLog {
  id             String        @id
  organizationId String?
  userId         String?
  action         String
  targetEntity   String
  targetId       String
  metadataJson   String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}
