{
  "name": "claim-center-report-studio-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "postinstall": "pnpm --filter @claim-studio/database generate",
    "db:migrate": "pnpm --filter @claim-studio/database db:migrate",
    "db:seed": "pnpm --filter @claim-studio/database db:seed",
    "db:reset": "pnpm --filter @claim-studio/database db:reset",
    "lint": "tsx scripts/harness-check.ts lint",
    "typecheck": "tsx scripts/harness-check.ts typecheck",
    "test": "tsx --test scripts/harness-test.ts",
    "test:e2e": "tsx scripts/p06-e2e.ts && tsx scripts/p07-e2e.ts && tsx scripts/p08-e2e.ts",
    "test:security": "tsx --test scripts/p04-security-test.ts scripts/p05-security-test.ts scripts/p06-security-test.ts scripts/p07-security-test.ts scripts/p08-security-test.ts",
    "build": "tsx scripts/harness-check.ts build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/sql.js": "1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "playwright-core": "^1.55.0",
    "sql.js": "1.13.0",
    "tsx": "^4.23.6",
    "typescript": "^5.7.2"
  }
}
