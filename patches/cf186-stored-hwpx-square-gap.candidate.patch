+    #[test]
+    fn hwpx_square_gap_rejects_edited_geometry_page_reset_and_overflow() {
+        for (host_y, height, next_y, spacing) in [
+            (5504, 14258, 20228, 2252), // Edited height with stale ladder.
+            (5504, 14158, 20227, 2252),
+            (5504, 14158, 20229, 2252),
+            (5504, 14158, 0, 2252), // A new physical page is not this gap.
+            (5504, 14158, 20228, 566),
+            (5504, u32::MAX, 20228, 2252),
+            (0, i32::MAX as u32, i32::MAX, 2252),
+            (i32::MIN, 14158, i32::MAX, 2252),
+        ] {
+            let (host, next) = hwpx_square_gap_candidate(host_y, height, next_y, spacing);
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(true, false, &host, Some(&next)),
+                None
+            );
+        }
+        let (mut host, next) = hwpx_square_gap_candidate(5504, 14158, 20228, 2252);
+        let Control::Table(table) = &mut host.controls[0] else {
+            unreachable!()
+        };
+        table.outer_margin_bottom += 1;
+        assert_eq!(
+            stored_hwpx_square_table_gap_hu(true, false, &host, Some(&next)),
+            None
+        );
+    }
