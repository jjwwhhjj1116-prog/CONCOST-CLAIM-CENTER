+/// An original HWPX Square table can encode its trailing gap in the next
+/// paragraph's stored position, rather than in the anchor's text line spacing.
+/// Only accept the exact declared-height + outer-margins contract; stale or
+/// recomposed ladders and edited table measurements must use normal flow.
+pub(crate) fn stored_hwpx_square_table_gap_hu(
+    original_hwpx: bool,
+    table_reflowed: bool,
+    para: &Paragraph,
+    next_para: Option<&Paragraph>,
+) -> Option<i32> {
+    use crate::model::paragraph::{ColumnBreakType, LineSeg};
+
+    let [Control::Table(table)] = para.controls.as_slice() else {
+        return None;
+    };
+    let next = next_para?;
+    let cm = &table.common;
+    let stored = |p: &Paragraph| {
+        !p.line_segs_recomputed
+            && !p.stored_text_partition_is_dirty()
+            && p.layout_only_fill_lines == 0
+            && p.source_line_seg_vertical_pos
+                .as_ref()
+                .is_none_or(|source| source.len() == p.line_segs.len())
+            && p.line_segs
+                .iter()
+                .all(|line| line.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0)
+    };
+    if !original_hwpx
+        || table_reflowed
+        || cm.treat_as_char
+        || cm.text_wrap != TextWrap::Square
+        || !cm.flow_with_text
+        || cm.allow_overlap
+        || cm.vert_rel_to != VertRelTo::Para
+        || cm.vert_align != VertAlign::Top
+        || cm.horz_rel_to != HorzRelTo::Para
+        || cm.horz_align != HorzAlign::Left
+        || cm.vertical_offset != 0
+        || cm.horizontal_offset != 0
+        || table.page_break != TablePageBreak::RowBreak
+        || table.row_count <= 1
+        || table.col_count == 0
+        || table.cell_spacing != 0
+        || table.caption.is_some()
+        || para.text.chars().any(|c| c > '\u{001F}' && c != '\u{FFFC}')
+        || para.column_type != ColumnBreakType::None
+        || !next.controls.is_empty()
+        || next.column_type != ColumnBreakType::None
+        || !stored(para)
+        || !stored(next)
+        || table.cells.is_empty()
+        || table.cells.iter().any(|cell| {
+            cell.row_span == 0
+                || cell.col_span == 0
+                || usize::from(cell.row) + usize::from(cell.row_span) > usize::from(table.row_count)
+                || usize::from(cell.col) + usize::from(cell.col_span) > usize::from(table.col_count)
+                || cell.paragraphs.is_empty()
+                || cell.paragraphs.iter().any(|p| {
+                    p.line_segs.is_empty()
+                        || !stored(p)
+                        || p.controls
+                            .iter()
+                            .any(|control| matches!(control, Control::Table(_)))
+                })
+        })
+        || table.outer_margin_top < 0
+        || table.outer_margin_bottom < 0
+    {
+        return None;
+    }
+    let [host] = para.line_segs.as_slice() else {
+        return None;
+    };
+    let following = next.line_segs.first()?;
+    if host.line_height <= 0 || following.line_height <= 0 {
+        return None;
+    }
+    let height = i32::try_from(cm.height).ok()?;
+    let row_heights = table.get_raw_row_heights();
+    if row_heights.iter().any(|height| *height == 0)
+        || row_heights
+            .iter()
+            .try_fold(0u32, |sum, height| sum.checked_add(*height))?
+            != cm.height
+    {
+        return None;
+    }
+    let margins = i32::from(table.outer_margin_top) + i32::from(table.outer_margin_bottom);
+    let host_vpos = ladder_vpos(para, 0, host.vertical_pos);
+    let next_vpos = ladder_vpos(next, 0, following.vertical_pos);
+    let delta = next_vpos.checked_sub(host_vpos)?;
+    (host_vpos >= 0
+        && height > 0
+        && margins > 0
+        && margins < host.line_spacing
+        && delta == height.checked_add(margins)?)
+    .then_some(margins)
+}
