+    fn hwpx_square_gap_candidate(
+        host_vpos: i32,
+        height: u32,
+        next_vpos: i32,
+        line_spacing: i32,
+    ) -> (Paragraph, Paragraph) {
+        let table = Table {
+            row_count: 2,
+            col_count: 3,
+            page_break: TablePageBreak::RowBreak,
+            outer_margin_top: 283,
+            outer_margin_bottom: 283,
+            cells: (0..2)
+                .map(|row| Cell {
+                    row,
+                    row_span: 1,
+                    col_span: 1,
+                    height: if row == 0 {
+                        3080
+                    } else {
+                        height.saturating_sub(3080)
+                    },
+                    paragraphs: vec![Paragraph {
+                        line_segs: vec![LineSeg {
+                            line_height: 1100,
+                            tag: LineSeg::TAG_SINGLE_SEGMENT_LINE,
+                            ..Default::default()
+                        }],
+                        ..Default::default()
+                    }],
+                    ..Default::default()
+                })
+                .collect(),
+            common: CommonObjAttr {
+                height,
+                flow_with_text: true,
+                text_wrap: TextWrap::Square,
+                horz_rel_to: HorzRelTo::Para,
+                horz_align: HorzAlign::Left,
+                vert_rel_to: VertRelTo::Para,
+                vert_align: VertAlign::Top,
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        let host = Paragraph {
+            controls: vec![Control::Table(Box::new(table))],
+            line_segs: vec![LineSeg {
+                vertical_pos: host_vpos,
+                line_height: 1100,
+                line_spacing,
+                tag: LineSeg::TAG_SINGLE_SEGMENT_LINE,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let next = Paragraph {
+            line_segs: vec![LineSeg {
+                vertical_pos: next_vpos,
+                line_height: 1100,
+                tag: LineSeg::TAG_SINGLE_SEGMENT_LINE,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        (host, next)
+    }
+
+    #[test]
+    fn hwpx_square_gap_uses_exact_original_ladder_not_text_spacing() {
+        for (host_y, height, next_y, spacing) in
+            [(5504, 14158, 20228, 2252), (25732, 19204, 45502, 1652)]
+        {
+            let (mut host, mut next) = hwpx_square_gap_candidate(host_y, height, next_y, spacing);
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(true, false, &host, Some(&next)),
+                Some(566)
+            );
+            // Axis normalization may shift working vpos; the intact source
+            // snapshot is the authority for this original-layout contract.
+            host.source_line_seg_vertical_pos = Some(vec![host_y]);
+            next.source_line_seg_vertical_pos = Some(vec![next_y]);
+            host.line_segs[0].vertical_pos += 100;
+            next.line_segs[0].vertical_pos += 200;
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(true, false, &host, Some(&next)),
+                Some(566)
+            );
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(false, false, &host, Some(&next)),
+                None
+            );
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(true, true, &host, Some(&next)),
+                None
+            );
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(true, false, &host, None),
+                None
+            );
+        }
+    }
+
+    #[test]
+    fn hwpx_square_gap_rejects_recomputed_dirty_or_partial_ladders() {
+        let (host, next) = hwpx_square_gap_candidate(5504, 14158, 20228, 2252);
+        for change_host in [true, false] {
+            for kind in 0..6 {
+                let (mut candidate_host, mut candidate_next) = (host.clone(), next.clone());
+                let p = if change_host {
+                    &mut candidate_host
+                } else {
+                    &mut candidate_next
+                };
+                match kind {
+                    0 => p.line_segs_recomputed = true,
+                    1 => p.stored_text_partition_dirty = true,
+                    2 => p.layout_only_fill_lines = 1,
+                    3 => p.line_segs[0].tag |= LineSeg::TAG_IMPLEMENTATION_PROPERTY,
+                    4 => p.source_line_seg_vertical_pos = Some(vec![]),
+                    _ => p.line_segs.clear(),
+                }
+                assert_eq!(
+                    stored_hwpx_square_table_gap_hu(
+                        true,
+                        false,
+                        &candidate_host,
+                        Some(&candidate_next)
+                    ),
+                    None
+                );
+            }
+        }
+        let mut mixed_next = next.clone();
+        mixed_next.line_segs.push(LineSeg {
+            tag: LineSeg::TAG_IMPLEMENTATION_PROPERTY,
+            ..Default::default()
+        });
+        assert_eq!(
+            stored_hwpx_square_table_gap_hu(true, false, &host, Some(&mixed_next)),
+            None
+        );
+    }
+
+    #[test]
+    fn hwpx_square_gap_rejects_neighboring_table_contracts() {
+        let (host, next) = hwpx_square_gap_candidate(5504, 14158, 20228, 2252);
+        for kind in 0..17 {
+            let mut candidate = host.clone();
+            let Control::Table(table) = &mut candidate.controls[0] else {
+                unreachable!()
+            };
+            match kind {
+                0 => table.common.treat_as_char = true,
+                1 => table.common.text_wrap = TextWrap::TopAndBottom,
+                2 => table.common.flow_with_text = false,
+                3 => table.common.allow_overlap = true,
+                4 => table.common.vert_rel_to = VertRelTo::Page,
+                5 => table.common.vert_align = VertAlign::Bottom,
+                6 => table.common.horz_rel_to = HorzRelTo::Column,
+                7 => table.common.horz_align = HorzAlign::Right,
+                8 => table.common.vertical_offset = 1,
+                9 => table.common.vertical_offset = u32::MAX,
+                10 => table.common.horizontal_offset = 1,
+                11 => table.page_break = TablePageBreak::CellBreak,
+                12 => table.row_count = 1,
+                13 => table.caption = Some(Default::default()),
+                14 => table.outer_margin_top = -1,
+                15 => table.cell_spacing = 1,
+                _ => table.cell_spacing = -1,
+            }
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(true, false, &candidate, Some(&next)),
+                None
+            );
+        }
+        let mut visible_host = host.clone();
+        visible_host.text = "표 제목".into();
+        assert_eq!(
+            stored_hwpx_square_table_gap_hu(true, false, &visible_host, Some(&next)),
+            None
+        );
+        let mut multiple_controls = host.clone();
+        multiple_controls.controls.push(host.controls[0].clone());
+        assert_eq!(
+            stored_hwpx_square_table_gap_hu(true, false, &multiple_controls, Some(&next)),
+            None
+        );
+        let mut next_table = next.clone();
+        next_table.controls = host.controls.clone();
+        assert_eq!(
+            stored_hwpx_square_table_gap_hu(true, false, &host, Some(&next_table)),
+            None
+        );
+        let mut page_break = next.clone();
+        page_break.column_type = crate::model::paragraph::ColumnBreakType::Page;
+        assert_eq!(
+            stored_hwpx_square_table_gap_hu(true, false, &host, Some(&page_break)),
+            None
+        );
+    }
