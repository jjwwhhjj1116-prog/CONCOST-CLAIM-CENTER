+                6 => table.cells.clear(),
+                7 => table.cells[0].height = 0,
+                8 => table.cells[0].paragraphs.clear(),
+                9 => table.col_count = 0,
+                10 => table.cells[0].col_span = 0,
+                11 => table.cells[0].row_span = 0,
+                12 => table.cells[0].col = u16::MAX,
+                _ => table.cells[0].row_span = u16::MAX,
+            }
+            assert_eq!(
+                stored_hwpx_square_table_gap_hu(true, false, &candidate, Some(&next)),
+                None
+            );
+        }
+    }
