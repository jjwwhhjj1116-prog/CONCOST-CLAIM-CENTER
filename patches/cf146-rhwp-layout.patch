+/// 저장 사다리가 그림 높이만 차지하는 빈 단일 그림 앵커. 이 경우 host 줄을
+/// 별도로 더하면 그림마다 한 줄씩 밀린다. 캡션/여백/합성 줄은 추정하지 않는다.
+pub(crate) fn stored_picture_host_included_advance_hu(
+    native_hwp5_layout: bool,
+    para: &Paragraph,
+    next_para: Option<&Paragraph>,
+) -> Option<i32> {
+    let [Control::Picture(pic)] = para.controls.as_slice() else {
+        return None;
+    };
+    let cm = &pic.common;
+    if !native_hwp5_layout
+        || !is_para_topbottom_float(cm)
+        || !cm.flow_with_text
+        || pic.caption.is_some()
+        || cm.vertical_offset != 0
+        || cm.margin.top != 0
+        || cm.margin.bottom != 0
+        || cm.margin.left != 0
+        || cm.margin.right != 0
+        || para.text.chars().any(|c| c > '\u{001F}' && c != '\u{FFFC}')
+    {
+        return None;
+    }
+    let [host] = para.line_segs.as_slice() else {
+        return None;
+    };
+    let next = next_para?;
+    let following = next.line_segs.first()?;
+    if host.tag & 0x8000_0000 != 0
+        || following.tag & 0x8000_0000 != 0
+        || host.line_height <= 0
+        || following.line_height <= 0
+        || para.layout_only_fill_lines != 0
+        || next.layout_only_fill_lines != 0
+    {
+        return None;
+    }
+    let height = i32::try_from(cm.height).ok()?;
+    let advance = host.line_height.checked_add(host.line_spacing)?;
+    let delta = ladder_vpos(next, 0, following.vertical_pos).checked_sub(ladder_vpos(
+        para,
+        0,
+        host.vertical_pos,
+    ))?;
+    (height > advance && advance > 0 && delta == height).then_some(advance)
+}
