+            controls: vec![Control::Picture(Box::new(picture))],
+            line_segs: vec![LineSeg {
+                vertical_pos: 10000,
+                line_height: 1100,
+                line_spacing: 880,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let mut next = Paragraph {
+            line_segs: vec![LineSeg {
+                vertical_pos: 15000,
+                line_height: 1100,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        assert_eq!(
+            stored_picture_host_included_advance_hu(true, &host, Some(&next)),
+            Some(1980)
+        );
+        next.line_segs[0].line_spacing = 880;
+        let mut caption = Paragraph {
+            text: "사진 설명".into(),
+            line_segs: vec![LineSeg {
+                vertical_pos: 16980,
+                line_height: 1100,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        assert!(stored_picture_gap_fits_body(
+            true, &host, &next, &caption, 18080
+        ));
+        assert!(!stored_picture_gap_fits_body(
+            true, &host, &next, &caption, 18079
+        ));
+        assert!(!stored_picture_gap_fits_body(
+            false, &host, &next, &caption, 18080
+        ));
+        caption.line_segs[0].vertical_pos += 1;
+        assert!(!stored_picture_gap_fits_body(
+            true, &host, &next, &caption, 19000
+        ));
+        caption.line_segs[0].vertical_pos -= 1;
+        caption.line_segs[0].tag = 0x8000_0000;
+        assert!(!stored_picture_gap_fits_body(
+            true, &host, &next, &caption, 19000
+        ));
+        next.line_segs[0].vertical_pos += 1980;
+        assert_eq!(
+            stored_picture_host_included_advance_hu(true, &host, Some(&next)),
+            None
+        );
+        next.line_segs[0].vertical_pos = 15000;
+        assert_eq!(
+            stored_picture_host_included_advance_hu(false, &host, Some(&next)),
+            None
+        );
+        host.line_segs[0].tag = 0x8000_0000;
+        assert_eq!(
+            stored_picture_host_included_advance_hu(true, &host, Some(&next)),
+            None
+        );
+        host.line_segs[0].tag = 0;
+        host.controls.push(host.controls[0].clone());
+        assert_eq!(
+            stored_picture_host_included_advance_hu(true, &host, Some(&next)),
+            None
+        );
+    }
