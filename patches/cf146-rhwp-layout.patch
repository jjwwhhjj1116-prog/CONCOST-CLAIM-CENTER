+/// 저장된 그림 뒤의 빈 줄과 한 줄 설명이 본문 안에서 연속되면 실제 간격이다.
+/// 뒤 설명 다음에 새 쪽이 온다는 이유만으로 이 빈 줄을 없애면 안 된다.
+pub(crate) fn stored_picture_gap_fits_body(
+    native_hwp5_layout: bool,
+    picture: &Paragraph,
+    gap: &Paragraph,
+    following: &Paragraph,
+    body_height_hu: i32,
+) -> bool {
+    if stored_picture_host_included_advance_hu(native_hwp5_layout, picture, Some(gap)).is_none()
+        || !gap.text.is_empty()
+        || !gap.controls.is_empty()
+        || !following.controls.is_empty()
+        || following.layout_only_fill_lines != 0
+    {
+        return false;
+    }
+    let ([blank], [text]) = (gap.line_segs.as_slice(), following.line_segs.as_slice()) else {
+        return false;
+    };
+    if text.tag & 0x8000_0000 != 0 || text.line_height <= 0 || blank.line_spacing < 0 {
+        return false;
+    }
+    let gap_start = i64::from(ladder_vpos(gap, 0, blank.vertical_pos));
+    let text_start = i64::from(ladder_vpos(following, 0, text.vertical_pos));
+    gap_start >= 0
+        && gap_start + i64::from(blank.line_height) + i64::from(blank.line_spacing) == text_start
+        && text_start + i64::from(text.line_height) <= i64::from(body_height_hu)
+}
