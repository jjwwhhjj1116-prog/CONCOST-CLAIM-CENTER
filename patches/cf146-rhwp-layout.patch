+        let mut st = TypesetState::new(layout, 1, 0, 0.0, 0.0, 0.0, Default::default());
+        st.current_height = st.available_height() * 0.2;
+        st.current_items.push(PageItem::PartialTable {
+            para_index: 0,
+            control_index: 0,
+            start_row: 1,
+            end_row: 2,
+            is_continuation: true,
+            start_cut: vec![],
+            end_cut: vec![],
+            is_block_split: false,
+            row_cursor_is_nested: false,
+            end_row_height_override: None,
+            start_row_height_override: None,
+        });
+        let make_paras = |wrap, tac| {
+            let mut table = Table::default();
+            table.common.text_wrap = wrap;
+            table.common.treat_as_char = tac;
+            vec![
+                Paragraph {
+                    controls: vec![Control::Table(Box::new(table))],
+                    ..Default::default()
+                },
+                Paragraph::default(),
+            ]
+        };
+        let overlay = make_paras(TextWrap::InFrontOfText, false);
+        assert!(page_holds_only_fresh_table_continuation(&st, &overlay));
+        assert!(!page_holds_only_fresh_table_continuation(
+            &st,
+            &make_paras(TextWrap::TopAndBottom, false)
+        ));
+        assert!(!page_holds_only_fresh_table_continuation(
+            &st,
+            &make_paras(TextWrap::InFrontOfText, true)
+        ));
+        assert!(!page_holds_only_fresh_table_continuation(&st, &[]));
+        st.current_items
+            .push(PageItem::FullParagraph { para_index: 1 });
+        assert!(page_holds_only_fresh_table_continuation(&st, &overlay));
+        let mut visible = overlay.clone();
+        visible[1].text = "본문".into();
+        assert!(!page_holds_only_fresh_table_continuation(&st, &visible));
+        st.current_height = st.available_height() * 0.31;
+        assert!(!page_holds_only_fresh_table_continuation(&st, &overlay));
+    }
